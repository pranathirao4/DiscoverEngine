# Copy this file to `env` (not committed) and fill in keys.
# No Reddit API key. No Apify key. Reddit is fetched via Arctic Shift.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local BGE embeddings (not OpenAI, not Groq). Override only if you need another BAAI checkpoint.
BGE_MODEL=BAAI/bge-small-en-v1.5

# Optional, Phase 3 YouTube comments only
YOUTUBE_API_KEY=
